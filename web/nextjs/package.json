{
  "name": "nextjs-counsel-studio-example-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "doppler run -- env NODE_ENV=development next dev -p 3001",
    "build": "NODE_ENV=production next build && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "PORT=3001 NODE_ENV=production node .next/standalone/server.js",
    "lint": "oxlint src/",
    "format": "oxfmt 'src/**/*.{ts,tsx}'",
    "format:check": "oxfmt --check 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run lint && bun run test"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "jose": "^6.2.12",
    "lucide-react": "^0.561.0",
    "next": "16.4.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^13.0.2",
    "zod": "^4.6.5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.2"
}
