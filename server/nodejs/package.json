{
  "name": "typescript-node-server",
  "version": "1.0.0",
  "description": "A simple TypeScript Node.js HTTP server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --minify src/index.ts --outfile ./server",
    "compile-and-run": "bun compile && ./server",
    "lint": "oxlint src/",
    "format": "oxfmt 'src/**/*.ts'",
    "format:check": "oxfmt --check 'src/**/*.ts'",
    "dev": "NODE_ENV=development doppler run -- bun --hot src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run lint && bun run test && bun run typecheck && bun run compile",
    "ci": "bun install --production && bun run compile",
    "ci:write-env": "bun scripts/write-ci-env.ts",
    "healthcheck": "sh ./healthcheck.sh"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.30",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "standardwebhooks": "^1.1.1",
    "uuid": "^13.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "bun-types": "^1.4.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.2"
}
